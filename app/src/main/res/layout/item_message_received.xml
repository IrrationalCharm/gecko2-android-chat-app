<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:paddingStart="8dp"
    android:paddingEnd="48dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/cvReceiverAvatar"
        android:layout_width="28dp"
        android:layout_height="28dp"
        app:cardCornerRadius="14dp"
        app:cardBackgroundColor="@color/green_faded"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="@id/msgContainer"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/imgReceiverAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/person_icon"
            android:scaleType="centerCrop" />
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/msgContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_message_received"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintStart_toEndOf="@id/cvReceiverAvatar"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvMessageContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This is a received message."
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvMessageTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:text="10:31 PM"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>